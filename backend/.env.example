# VEXO Backend Configuration
# Copy this file to .env and modify the values as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=VEXO Image Validation API
API_VERSION=1.0.0

# CORS Configuration
# Use "*" for all origins in development, specify domains for production
CORS_ORIGINS=*
# For production, use specific origins like:
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Model Configuration
MODEL_PATH=vexo_v4_2.keras
VALIDITY_THRESHOLD=0.5
XCEPTION_INPUT_WIDTH=299
XCEPTION_INPUT_HEIGHT=299

# File Upload Limits (0 or unset = no limit)
MAX_FILES_PER_REQUEST=0
MAX_URLS_PER_REQUEST=0

# OCR Configuration
OCR_CONFIDENCE_THRESHOLD=0.3
OCR_LANGUAGES=en

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Google Drive Configuration
GOOGLE_CREDENTIALS_FILE=credentials.json

# Development vs Production
# For development:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 
# For production:
# CORS_ORIGINS=https://yourdomain.com
# LOG_LEVEL=WARNING
# VALIDITY_THRESHOLD=0.7
